# Required in every environment
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Required in production (SPRING_PROFILES_ACTIVE=prod); no fallback there
JWT_SECRET=
# 12+ characters; replaces the seed admin's published password on first prod start
ADMIN_INITIAL_PASSWORD=
# 12+ characters; replaces the demo artists' published password in prod (else they are deactivated)
DEMO_ARTIST_PASSWORD=

DB_URL=jdbc:postgresql://localhost:5432/artkezai
DB_USER=artkezai_user
DB_PASS=
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=artkezai-paintings
MINIO_PUBLIC_URL=http://localhost:9000/artkezai-paintings

MAIL_HOST=localhost
MAIL_PORT=1025
